<!DOCTYPE html>
<html lang="nl">
	<head>
		<meta charset="UTF-8">
			<meta name="viewport" content="width=device-width, initial-scale=1.0">
				<title>Interactieve Poster</title>
				<style>
					* {
					margin: 0;
					padding: 0;
					box-sizing: border-box;
					}

					body, html {
					width: 100%;
					height: 100%;
					background-color: #000000;
					font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
					}

					/* Pagina 1: Zwart scherm */
					#pagina-1 {
					width: 100vw;
					height: 100vh;
					background-color: #000000;
					display: flex;
					justify-content: center;
					align-items: center;
					overflow: hidden;
					}

					/* De bol: direct zichtbaar met een subtiele rand en kern */
					.bol {
					width: 200px;
					height: 200px;
					border-radius: 50%;
					cursor: pointer;
					position: relative;
					border: 1px solid rgba(255, 255, 255, 0.15);
					background: radial-gradient(circle, rgba(255, 255, 255, 0.25) 0%, rgba(255, 255, 255, 0.06) 65%, rgba(0, 0, 0, 0) 100%);
					animation: lichtPuls 3.5s infinite ease-in-out;
					transition: transform 0.4s ease, background 0.4s ease, box-shadow 0.4s ease, border-color 0.4s ease;
					}

					@keyframes lichtPuls {
					0%, 100% {
					box-shadow: inset 0 0 20px rgba(255, 255, 255, 0.08), 0 0 25px rgba(255, 255, 255, 0.05);
					transform: scale(0.98);
					}
					50% {
					box-shadow: inset 0 0 45px rgba(255, 255, 255, 0.35), 0 0 50px rgba(255, 255, 255, 0.2);
					transform: scale(1.02);
					}
					}

					.bol:hover {
					animation: none;
					transform: scale(1.08);
					border-color: rgba(255, 255, 255, 1);
					background: radial-gradient(circle, rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0.9) 60%, rgba(255, 255, 255, 0.4) 100%);
					box-shadow: 0 0 90px 35px rgba(255, 255, 255, 0.95);
					}

					/* Pagina 2: Wit scherm */
					#pagina-2 {
					display: none;
					min-height: 100vh;
					width: 100%;
					background-color: #ffffff;
					justify-content: center;
					align-items: center;
					padding: 20px;
					position: relative;
					}

					/* Volledige poster zichtbaar zonder afsnijden */
					#pagina-2 img {
					max-width: 100%;
					max-height: 95vh;
					width: auto;
					height: auto;
					object-fit: contain;
					display: block;
					}

					/* Zwarte BACK-knop linksbovenaan */
					.back-btn {
					position: fixed;
					top: 24px;
					left: 24px;
					z-index: 10;
					background: rgba(255, 255, 255, 0.85);
					border: none;
					color: #000000;
					font-size: 14px;
					font-weight: 700;
					letter-spacing: 0.12em;
					text-transform: uppercase;
					cursor: pointer;
					padding: 6px 10px;
					transition: opacity 0.25s ease, transform 0.25s ease;
					}

					.back-btn:hover {
					opacity: 0.55;
					transform: translateX(-2px);
					}
				</style>
			</head>
	<body>

		<!-- Scherm 1 -->
		<div id="pagina-1">
			<div class="bol" onclick="gaNaarPoster()"></div>
		</div>

		<!-- Scherm 2: Volledige poster met BACK-knop -->
		<div id="pagina-2">
			<button class="back-btn" onclick="gaTerug()">BACK</button>
			<img src="postersite.jpg" alt="A Trace of Warmth Poster">
  </div>

		<script>
			function gaNaarPoster() {
			document.getElementById('pagina-1').style.display = 'none';
			document.getElementById('pagina-2').style.display = 'flex';
			}

			function gaTerug() {
			document.getElementById('pagina-2').style.display = 'none';
			document.getElementById('pagina-1').style.display = 'flex';
			}
		</script>

	</body>
</html>
